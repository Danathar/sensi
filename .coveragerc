# Coverage configuration.
#
# Committed so that what gets measured is defined by this repository rather
# than by whatever the devcontainer image's gitignored pyproject.toml happens
# to say. Before this file existed, coverage outside that image was only
# whatever `--cov=custom_components.sensi` picked up, which meant the number in
# CI and the number a contributor saw locally were not guaranteed to be the
# same measurement.
#
# The threshold itself lives in .github/workflows/coverage-gate.yml, not here,
# so that a local run reports honestly instead of failing.

[run]
source = custom_components/sensi
# Both outcomes of every branch, not just "the line ran". The thirteen
# reachable outcomes no tier took were closed first (#85, PR #86); the one
# partial left is client.py's `while item := self._event_queue.get_nowait()`,
# whose false arm is unreachable by construction (EventInfo has no __bool__,
# so the loop only exits through QueueEmpty). That keeps the combined figure
# at 99%, above the gate's MIN_COVERAGE without a threshold change.
branch = true

[report]
show_missing = true
skip_covered = false
exclude_also =
    # Unreachable by construction.
    if TYPE_CHECKING:
    raise NotImplementedError
    ^\s*\.\.\.$

    # Debug representations. Exercised by the logging calls in client.py, but a
    # missing __str__ is not the kind of gap the gate exists to catch.
    def __repr__

[xml]
output = coverage.xml
